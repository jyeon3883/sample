{
  "name": "next-tanstack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r --filter \"./packages/*\" typecheck",
    "codegen": "pnpm --filter @repo/api-client codegen",
    "codegen:main": "pnpm --filter @repo/api-client codegen:main",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@repo/api-client": "workspace:*",
    "@repo/query": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/ui": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "next": "16.1.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.77.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.1",
      "react-dom": "19.2.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
