{
  "name": "next-tanstack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @repo/web build",
    "build:admin": "pnpm --filter @repo/admin build",
    "lint": "turbo run lint",
    "lint:web": "pnpm --filter @repo/web lint",
    "lint:admin": "pnpm --filter @repo/admin lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "typecheck:admin": "pnpm --filter @repo/admin typecheck",
    "codegen": "pnpm --filter @repo/api-client codegen",
    "codegen:main": "pnpm --filter @repo/api-client codegen:main",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "turbo": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.1",
      "react-dom": "19.2.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
