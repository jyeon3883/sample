{
  "name": "next-tanstack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "create:app": "node scripts/create-app.mjs",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @repo/web dev",
    "dev:admin": "pnpm --filter @repo/admin dev",
    "dev:sample": "pnpm --filter @repo/sample dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter @repo/web build",
    "build:web:dev": "pnpm --filter @repo/web build:dev",
    "build:web:prod": "pnpm --filter @repo/web build:prod",
    "build:admin": "pnpm --filter @repo/admin build",
    "build:admin:dev": "pnpm --filter @repo/admin build:dev",
    "build:admin:prod": "pnpm --filter @repo/admin build:prod",
    "build:sample": "pnpm --filter @repo/sample build",
    "build:sample:dev": "pnpm --filter @repo/sample build:dev",
    "build:sample:prod": "pnpm --filter @repo/sample build:prod",
    "lint": "turbo run lint",
    "lint:web": "pnpm --filter @repo/web lint",
    "lint:admin": "pnpm --filter @repo/admin lint",
    "lint:sample": "pnpm --filter @repo/sample lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "pnpm --filter @repo/web typecheck",
    "typecheck:admin": "pnpm --filter @repo/admin typecheck",
    "typecheck:sample": "pnpm --filter @repo/sample typecheck",
    "codegen": "cross-env APP_ENV=local pnpm --filter @repo/api-client codegen",
    "codegen:main": "cross-env APP_ENV=local pnpm --filter @repo/api-client codegen:main",
    "storybook": "pnpm --filter @repo/ui storybook",
    "build-storybook": "pnpm --filter @repo/ui build-storybook"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "turbo": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.1",
      "react-dom": "19.2.1"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
